#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PYTHON_BIN="${PYTHON_BIN:-python3.14}"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "Python 3.14.2 or newer is required. Set PYTHON_BIN to a compatible executable." >&2
  exit 1
fi

"$PYTHON_BIN" - <<'PY'
import sys

minimum = (3, 14, 2)
if sys.version_info < minimum:
    found = ".".join(map(str, sys.version_info[:3]))
    required = ".".join(map(str, minimum))
    raise SystemExit(f"Python {required}+ is required; found {found}")
PY

"$PYTHON_BIN" -m venv .venv
. .venv/bin/activate
python -m pip install --upgrade pip
python -m pip install -r requirements-test.txt -r requirements-runtime.txt

echo "Development environment ready. Activate it with: source .venv/bin/activate"
